// Recipe app database schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A user owns recipes. Accounts are email + password (lib/auth.ts); sign-up is
// open to everyone (bot check + limits) and starts with a copy of the
// showcase recipes. Each user sees only their own
// recipes.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String? // scrypt hash (lib/password.ts); null for the legacy placeholder owner and accounts that sign in with Google/Facebook only
  name      String?
  // Demo visitors get a temporary guest account (lib/demo.ts), deleted after
  // guestExpiresAt; signing up turns it into a normal account.
  isGuest        Boolean   @default(false)
  // The account whose recipes visitors browse and the demo copies (at most
  // one; set with scripts/set-showcase.ts). No personal data in config.
  isShowcase     Boolean   @default(false)
  // May open the statistics page (/admin/stats); set with scripts/set-admin.ts.
  isAdmin        Boolean   @default(false)
  guestExpiresAt DateTime?
  recipes   Recipe[]
  sessions  Session[]
  oauthTokens OAuthToken[]
  logins    SocialLogin[]
  createdAt DateTime @default(now())

  @@index([isGuest, guestExpiresAt])
}

// A signed-in browser. The cookie holds a random token; we store only its
// SHA-256 hash as the id, so a leaked database can't be used to hijack logins.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Recipe {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  title        String
  ingredients  String // JSON-encoded string[] — e.g. ["2 cups flour","1 tsp salt"]
  instructions String // JSON-encoded string[] — ordered steps
  sourceType   String    @default("manual") // "url" | "photo" | "voice" | "manual"
  sourceUrl    String?
  imagePath    String? // the picture shown (dish photo or generated), if any
  scanPaths    String? // JSON string[] — the photos the recipe was read from (photo import)
  copiedFromId String? // the showcase recipe this is a copy of (demo / starter copies)
  deletedAt    DateTime? // soft delete — set instead of erasing (Trash)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([deletedAt])
}

// AI usage, for the limits in lib/aiBudget.ts and the statistics in
// lib/stats.ts. Kinds: "import" — one per import a person starts (daily
// quotas); "call" — one per AI model request, with tokens and cost in USD
// (free models cost 0; the paid budget sums these); "guest" — a demo started;
// "paid" — older paid-call rows (before "call" existed); "chatgpt" — ChatGPT
// used one of its tools on someone's recipes (purpose = the tool; app/mcp).
model AiUsage {
  id               String   @id @default(cuid())
  kind             String
  userId           String?
  isGuest          Boolean  @default(false) // made from a demo
  ip               String?
  model            String?
  purpose          String? // "call": "read-recipe" | "choose-photos" | "describe-dish" | "draw-dish"
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

// Recipe activity for the daily statistics: "created" | "edited" |
// "deleted" (to Trash) | "restored" | "erased" (deleted for good).
model Activity {
  id        String   @id @default(cuid())
  kind      String
  userId    String
  isGuest   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ChatGPT (and other MCP apps) sign in with OAuth 2.1 (lib/oauth.ts): each app
// registers itself (dynamic client registration), the person approves it on
// /oauth/authorize, and the app gets tokens for /mcp that read that person's
// recipes. Codes and tokens are stored only as SHA-256 hashes.
model OAuthClient {
  id           String   @id // client_id
  name         String?
  redirectUris String // JSON string[]
  createdAt    DateTime @default(now())
}

// A one-time code from an approval, exchanged for tokens within minutes.
model OAuthCode {
  id            String   @id // sha256(code)
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String // PKCE, S256
  expiresAt     DateTime
}

// An access token ("access", short-lived) or refresh token ("refresh",
// rotated on every use).
model OAuthToken {
  id        String   @id // sha256(token)
  kind      String
  clientId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Signing in with Google or Facebook (lib/socialLogin.ts): which of their
// accounts belongs to which of ours. Found by this link first, then by the
// same (verified) e-mail.
model SocialLogin {
  id                String   @id @default(cuid())
  provider          String // "google" | "facebook"
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}
