// Recipe app database schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A user owns recipes. Accounts are email + password (lib/auth.ts); sign-up is
// gated by an invite code so only family can join. Each user sees only their own
// recipes.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String? // scrypt hash (lib/password.ts); null only for the legacy placeholder owner
  name      String?
  recipes   Recipe[]
  sessions  Session[]
  createdAt DateTime @default(now())
}

// A signed-in browser. The cookie holds a random token; we store only its
// SHA-256 hash as the id, so a leaked database can't be used to hijack logins.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Recipe {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  title        String
  ingredients  String // JSON-encoded string[] — e.g. ["2 cups flour","1 tsp salt"]
  instructions String // JSON-encoded string[] — ordered steps
  sourceType   String    @default("manual") // "url" | "photo" | "voice" | "manual"
  sourceUrl    String?
  imagePath    String? // stored photo path, if any
  deletedAt    DateTime? // soft delete — set instead of erasing (Trash)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([deletedAt])
}

// AI usage, for the limits in lib/aiBudget.ts. One "import" row per import a
// person starts (daily quotas), one "paid" row per paid-model call with its
// cost in USD (monthly/daily budget).
model AiUsage {
  id        String   @id @default(cuid())
  kind      String // "import" | "paid"
  userId    String?
  ip        String?
  model     String?
  costUsd   Float    @default(0)
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
}
